        max-width: 400px;
        border-radius: 8px;
        transition: background 0.3s, color 0.3s;
      }

      .thca_flower_block-col .thca_flower_block-btn:hover {
        background: #fff; /* White on hover */
        color: #000; /* Black Text */
      }

      .thca_flower_block-col img {
        width: 100%;
        border-radius: 8px;
      }

      .thca_flower_block-col p {
        font-family: 'ITC Legacy Sans Std';
        font-weight: 500;
        font-size: 16px;
        line-height: 24px;
        color: #e0e0e0; /* Light Gray for readability on black */
        position: relative;
        padding-left: 24px;
      }

      .thca_flower_block-col p::before {
        content: '';
        position: absolute;
        left: 10px;
        top: 8px;
        width: 8px;
        height: 8px;
        background: #39ff14; /* Neon Green Bullet */
        border-radius: 50%;
      }

      @media screen and (max-width: 1140px) {
        .thca_flower_block-wrapper {
          padding: 20px 16px;
        }
      }

      @media screen and (max-width: 840px) {
        .thca_flower_block-wrapper {
          padding: 0 0 40px;
          flex-direction: column;
        }

        .thca_flower_block-col {
          width: 100%;
        }

        .thca_flower_block-btn {
          margin: auto;
        }

        .thca_flower_block-wrapper .thca_flower_block-col:last-child {
          padding: 24px 16px 0;
        }
      }
    </style>

    <div class="thca_flower_block-wrapper">
      <div class="thca_flower_block-col">
        <img
          src="https://cdn.accentuate.io/184373903495/1629294834412/secretcbd-3139.jpeg?v=1629328273410"
          alt="THCA Flower"
        >
      </div>
      <div class="thca_flower_block-col">
        <h2>The Best THCA Extracts</h2>
        <p>
          All of our THCA extracts are made from premium, organically grown cannabis flower. We hold our extract
          products to the highest standards, focusing on live resin, solventless, whole-plant extracts. Our THCA live
          resin retains the full range of cannabinoids and terpenes naturally found in the cannabis plant. By flash
          freezing our flowers at harvest, we preserve their delicate cannabinoids and terpenes in their living state.
          This process ensures the freshest, most aromatic extracts with maximum potency.
        </p>

        <h2>True Essence & Variety</h2>
        <p>
          Quality and effectiveness are key to capturing the true essence of the cannabis plant. Our live resin THCA
          extracts and terpene-infused products preserve the natural profiles of the plant to deliver superior potency,
          flavor, and effects. From concentrates to water-soluble capsules, we offer a variety of options to meet your
          preferred method of consumption. Discover the difference of our curated, high-quality THCA products, designed
          to deliver the most authentic cannabis experience.
        </p>
        <a class="thca_flower_block-btn" href="https://zazadepotmi.myshopify.com/collections/thc-flower">
          LEARN MORE ABOUT THCA FLOWER
        </a>
      </div>
    </div>
  </div>
{% endif %}

{% if collection.handle == 'welness-and-extracts' %}
  <div id="shopify-section-thca-faq" class="shopify-section">
    <style>
      /* Wrapper Styling */
      .Collection__Tabs-wrapper {
        padding: 40px 80px;
        background: #000;
      }

      .Collection__Tabs-wrapper h2 {
        font-family: "Editorial New";
        font-size: 40px;
        line-height: 64px;
        text-align: center;
        color: #39ff14; /* Neon Green */
      }

      /* FAQ Item Box */
      .tabs-open-faq {
        margin-bottom: 40px;
        background: #000;
        box-shadow: 0 0 15px 3px #39ff14; /* Neon Glow */
        padding: 20px;
        border: 1px solid #39ff14;
        border-radius: 8px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }

      .tabs-open-faq:hover {
        transform: scale(1.02); /* Slight Lift */
        box-shadow: 0 0 25px 5px #39ff14; /* Enhanced Glow */
      }

      /* FAQ Heading */
      .tabs-open-faq h5 {
        font-family: "ITC Legacy Sans Std";
        font-size: 16px;
        font-weight: 700;
        text-align: center;
        margin-bottom: 8px;
        color: #39ff14;
      }

      /* FAQ Paragraph */
      .tabs-open-faq p {
        font-family: "ITC Legacy Sans Std";
        font-size: 16px;
        font-weight: 500;
        line-height: 24px;
        text-align: center;
        color: #39ff14;
      }

      /* Mobile Responsiveness */
      @media screen and (max-width: 740px) {
        .Collection__Tabs-wrapper {
          padding: 24px 16px;
        }

        .Collection__Tabs-wrapper h2 {
          font-size: 20px;
          line-height: 32px;
        }

        .tabs-open-faq {
          padding: 15px;
        }

        .tabs-open-faq h5 {
          font-size: 14px;
        }

        .tabs-open-faq p {
          font-size: 14px;
        }
      }
    </style>

    <div class="Collection__Tabs-wrapper">
      <h2>Frequently Asked Questions</h2>
      <div class="Product__Tabs">
        <div class="tabs-open-faq">
          <h5>What is THCA live resin?</h5>
          <p>
            THCA live resin is an extract made from fresh cannabis flowers that are immediately frozen at harvest to
            preserve their natural cannabinoid and terpene profiles. This method retains the plant's full spectrum of
            compounds, resulting in a concentrate rich in flavor, aroma, and potency.
          </p>
        </div>

        <div class="tabs-open-faq">
          <h5>What does fresh frozen extract mean?</h5>
          <p>
            Fresh frozen refers to cannabis flowers that are flash-frozen immediately after harvest, rather than
            undergoing a traditional drying and curing process. This technique preserves the plant's natural terpene and
            cannabinoid profiles, leading to a more flavorful and aromatic extract.
          </p>
        </div>

        <div class="tabs-open-faq">
          <h5>What is a solventless THCA extract?</h5>
          <p>
            A solventless THCA extract is produced without the use of chemical solvents like CO₂, butane, or ethanol.
            Instead, mechanical methods such as rosin pressing or ice water extraction are employed to separate the
            beneficial compounds from the plant material, resulting in a pure and natural concentrate.
          </p>
        </div>

        <div class="tabs-open-faq">
          <h5>Are your THCA extracts lab tested?</h5>
          <p>
            Yes, all of our extract products undergo comprehensive lab testing to ensure purity, potency, and safety.
            Lab reports are available on the bottom footer of our website for your review.
          </p>
        </div>

        <div class="tabs-open-faq">
          <h5>What’s the difference between distillate and live resin?</h5>
          <p>
            Live resin retains all the terpenes and flavonoids, offering a rich and authentic flavor profile. Distillate
            is a refined extract consisting almost solely of cannabinoids, often lacking the natural terpenes. While
            distillate may have higher cannabinoid potency, live resin provides a more balanced and flavorful experience
            due to the entourage effect.
          </p>
        </div>

        <div class="tabs-open-faq">
          <h5>Which is healthier: live resin or distillate?</h5>
          <p>
            The health implications depend on production methods and any additives present. Live resin may offer a more
            holistic experience due to the entourage effect, where cannabinoids and terpenes work synergistically.
            Always choose products from reputable manufacturers who prioritize safety and quality.
          </p>
        </div>

        <div class="tabs-open-faq">
          <h5>Is live resin better for your lungs?</h5>
          <p>
            While live resin is valued for its rich terpene content, there’s no conclusive scientific evidence regarding
            its impact on lung health compared to other extracts. It’s crucial to consume responsibly and be aware of
            personal sensitivities.
          </p>
        </div>

        <div class="tabs-open-faq">
          <h5>Does live resin need to be refrigerated?</h5>
          <p>
            To maintain optimal freshness, store live resin in a cool, dark place. Refrigeration helps preserve its
            potency and flavor, but precautions should be taken to prevent moisture buildup and contamination. Using an
            airtight container is recommended.
          </p>
        </div>
      </div>
    </div>
  </div>
{% endif %}

