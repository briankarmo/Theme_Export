<style>
/* Main Container */
.bk-header-component {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: nowrap;
  background: linear-gradient(145deg, #000000, #555555);
  padding: 5px 0; /* Added vertical padding for top and bottom */
  box-sizing: border-box;
  width: 100%;
  gap: 10px;
}

.bk-header-box {
  cursor: pointer;
  text-align: center;
  transition: transform 0.3s, box-shadow 0.3s;
  margin-top: 1px; /* Added margin to lift images up slightly */
}

.bk-header-img, .bk-header-text {
  transition: box-shadow 0.3s, color 0.3s;
}

/* Hover effects */
.bk-header-box:hover .bk-header-img {
  box-shadow: 0 0 8px 2px rgba(0, 255, 0, 0.7);
  border-radius: 50%; /* Circular hover effect for images */
}

.bk-header-box:hover .bk-header-text {
  box-shadow: 0 0 8px 2px rgba(0, 255, 0, 0.7);
  background-color: rgba(0, 0, 0, 0.5); /* Square background hover for text */
  border-radius: 5px; /* Slight rounding of corners */
}

/* Active state styling for persistence */
.bk-header-box.active .bk-header-img, .bk-header-box.active .bk-header-text {
  color: #39ff14;
  text-shadow: 0 0 10px rgba(57, 255, 20, 0.8);
}

/* Text styling */
.bk-header-text {
  color: white;
  margin-top: 2px;
  font-size: 12px;
  font-weight: bold;
  font-family: Arial, sans-serif;
}

/* Responsive adjustments for images and text */
@media (max-width: 768px), (min-width: 769px) and (max-width: 1024px), (min-width: 1025px) {
  .bk-header-img {
    width: 50px; /* Consistent smaller size for all devices */
    height: 50px;
  }
  .bk-header-text {
    font-size: 10px; /* Smaller font size for consistency */
  }
}


</style>

