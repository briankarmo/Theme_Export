centered_on_a_black_background._Designed_for_use_as_an_icon_in_a_Shopify_store.png?v=1734494699\" \n             alt=\"Silver\">\n      <\/div>\n      <h3 class=\"grade-title silver-text\">Silver<\/h3>\n      <p>Premium quality for cost-conscious buyers.<\/p>\n      <button class=\"grade-button silver-classy\">Economy<\/button>\n    <\/a>\n  <\/div>\n<\/section>\n\n<style>\n\/* General Section Styles *\/\n.shop-grade-section {\n  padding: 20px;\n  background: linear-gradient(135deg, #000, #222); \/* Subtle grey gradient *\/\n  border-radius: 10px;\n  max-width: 1200px;\n  margin: 20px auto;\n  text-align: center;\n  box-shadow: 0 10px 25px rgba(0, 255, 0, 0.3);\n}\n\n\/* Header *\/\n.grade-header {\n  font-size: 26px;\n  color: #000;\n  font-weight: bold;\n  margin-bottom: 10px;\n  text-shadow: 0 0 8px rgba(0, 255, 0, 0.7), 0 0 18px rgba(0, 255, 0, 0.7);\n}\n\n.grade-subheader {\n  font-size: 14px;\n  color: #bbb;\n  margin-bottom: 30px;\n}\n\n\/* Grid Layout *\/\n.grade-container {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); \n  gap: 20px;\n  justify-content: center;\n  margin-bottom: 20px;\n}\n\n\/* Grade Card *\/\n.grade-card {\n  background: #111;\n  border-radius: 15px;\n  padding: 20px;\n  text-align: center;\n  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);\n  transition: transform 0.3s, box-shadow 0.3s;\n  text-decoration: none;\n}\n\n.grade-card:hover {\n  transform: scale(1.05);\n  box-shadow: 0 10px 30px rgba(0, 255, 0, 0.5);\n}\n\n\/* Grade Titles *\/\n.grade-title {\n  font-size: 16px;\n  color: #fff;\n  margin-bottom: 10px;\n  font-weight: bold;\n}\n\n.silver-text {\n  color: #c0c0c0;\n  text-shadow: 0 0 5px #c0c0c0;\n}\n\n.gold-text {\n  color: #ffd700;\n  text-shadow: 0 0 10px #ffd700, 0 0 20px #daa520;\n}\n\n.diamond-text {\n  color: #b9f2ff;\n  text-shadow: 0 0 5px #b9f2ff, 0 0 10px #ffffff;\n}\n\n\/* Grade Description *\/\n.grade-card p {\n  font-size: 13px;\n  color: #bbb;\n  line-height: 1.6;\n}\n\n\/* Image Wrapper with Smaller Image and Thinner Border *\/\n.grade-img-wrap {\n  width: 120px; \/* Smaller wrapper size *\/\n  height: 120px; \/* Smaller wrapper size *\/\n  margin: 0 auto 15px;\n  border-radius: 50%;\n  background: #222;\n  border: 0.5px solid #444; \/* Thinner bezel *\/\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  animation: strobe 3s infinite; \/* Strobing glow effect *\/\n  transition: transform 0.3s ease, box-shadow 0.3s ease;\n}\n\n.grade-img-wrap img {\n  width: 90%; \/* Smaller image size *\/\n  height: 90%;\n  object-fit: contain;\n  border-radius: 50%;\n  transition: transform 0.3s ease, filter 0.3s ease;\n}\n\n\/* Hover Effects for Images *\/\n.grade-img-wrap:hover {\n  transform: scale(1.1);\n  box-shadow: 0 0 20px rgba(0, 255, 0, 0.5);\n}\n\n.grade-img-wrap:hover img {\n  filter: brightness(1.2);\n}\n\n\/* Strobing Glow Keyframes *\/\n@keyframes strobe {\n  0%, 100% {\n    box-shadow: 0 0 10px #ffffff, 0 0 20px #ffffff;\n  }\n  50% {\n    box-shadow: 0 0 20px #ff00ff, 0 0 40px #ff00ff;\n  }\n}\n\n\/* Glow Effects *\/\n.silver-glow {\n  animation: silverStrobe 3s infinite;\n}\n\n.gold-glow {\n  animation: goldStrobe 3s infinite;\n}\n\n.diamond-glow {\n  animation: diamondStrobe 3s infinite;\n}\n\n\/* Individual Grade Keyframes *\/\n@keyframes silverStrobe {\n  0%, 100% {\n    box-shadow: 0 0 10px #c0c0c0, 0 0 20px #d8d8d8;\n  }\n  50% {\n    box-shadow: 0 0 20px #ffffff, 0 0 40px #ffffff;\n  }\n}\n\n@keyframes goldStrobe {\n  0%, 100% {\n    box-shadow: 0 0 10px #ffd700, 0 0 20px #daa520;\n  }\n  50% {\n    box-shadow: 0 0 20px #ffa500, 0 0 40px #ffcc00;\n  }\n}\n\n@keyframes diamondStrobe {\n  0%, 100% {\n    box-shadow: 0 0 10px #b9f2ff, 0 0 20px #ffffff;\n  }\n  50% {\n    box-shadow: 0 0 20px #00ffff, 0 0 40px #ffffff;\n  }\n}\n\n\/* Buttons *\/\n.grade-button {\n  margin-top: auto;\n  padding: 8px 16px;\n  background: linear-gradient(90deg, #00ff00, #008000);\n  color: #111;\n  border: none;\n  border-radius: 5px;\n  font-size: 14px;\n  font-weight: bold;\n  cursor: pointer;\n  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);\n  transition: transform 0.3s, box-shadow 0.3s;\n}\n\n.grade-button:hover {\n  transform: scale(1.05);\n  box-shadow: 0 5px 15px rgba(0, 255, 0, 0.7);\n}\n\n.grade-button:active {\n  background: linear-gradient(90deg, #006400, #007700);\n  transform: scale(0.95);\n  box-shadow: inset 0 3px 5px rgba(0, 0, 0, 0.5);\n}\n\n\/* Responsive Styles *\/\n@media (max-width: 1024px) {\n  .grade-container {\n    grid-template-columns: repeat(3, 1fr);\n  }\n}\n\n@media (max-width: 768px) {\n  .grade-container {\n    grid-template-columns: 1fr;\n  }\n}\n<\/style>","color_scheme":"","padding_top":20,"padding_bottom":20}},"1733710366c43e9ac4":{"type":"apps","blocks":{"judge_me_reviews_featured_carousel_AJXrzd":{"type":"shopify:\/\/apps\/judge-me-reviews\/blocks\/featured_carousel\/61ccd3b1-a9f2-4160-9fe9-4fec8413e5d8","settings":{"maxwidth":1080}}},"block_order":["judge_me_reviews_featured_carousel_AJXrzd"],"settings":{"include_margins":true}},"custom_liquid_JTJBtG":{"type":"custom-liquid","settings":{"custom_liquid":"<div style=\"background: linear-gradient(to bottom, black, grey); padding: 20px; border-radius: 10px; text-align: center; position: relative; box-shadow: 0 0 20px #39FF14;\">\n  <img \n    src=\"{{ 'file-YYm3remJtEdj2ePKRwLQak_1.png' | file_url }}\" \n    alt=\"Stylish Women in Dispensary\" \n    style=\"max-width: 100%; height: auto; border-radius: 8px; transition: transform 0.3s ease; box-shadow: 0 0 10px rgba(0, 255, 0, 0.5);\"\n    onmouseover=\"this.style.transform='scale(1.05)'\" onmouseout=\"this.style.transform='scale(1)'\"\n  \/>\n  <p style=\"color: #39FF14; font-size: 18px; margin-top: 10px; text-shadow: 0 0 5px #39FF14, 0 0 10px #39FF14; animation: neon 1.5s ease-in-out infinite alternate;\">Free Shipping on Orders $75+<\/p>\n<\/div>\n\n<style>\n  @keyframes neon {\n    0% {\n      text-shadow: 0 0 5px #39FF14, 0 0 10px #39FF14;\n    }\n    100% {\n   