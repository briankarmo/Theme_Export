ont-weight: bold;\n  line-height: 1.2;\n  margin-bottom: 20px;\n}\n\n.SectionHeader__Description p {\n  font-family: \"ITC Legacy Sans Std\", sans-serif;\n  font-size: 18px;\n  margin-bottom: 30px;\n  line-height: 1.5;\n}\n\n.Button {\n  display: inline-block;\n  padding: 12px 30px;\n  background-color: #39FF14; \/* Neon green button *\/\n  color: #000; \/* Black text *\/\n  font-family: \"ITC Legacy Sans Std\", sans-serif;\n  font-weight: bold;\n  text-transform: uppercase;\n  text-decoration: none;\n  border-radius: 5px;\n  transition: all 0.3s ease;\n}\n\n.Button:hover {\n  background-color: #2AD700; \/* Slightly darker green on hover *\/\n  transform: scale(1.05);\n}\n\n\/* Responsive Mobile Fixes *\/\n@media (max-width: 768px) {\n  .SectionHeader__Heading {\n    font-size: 28px;\n  }\n\n  .SectionHeader__Description p {\n    font-size: 16px;\n  }\n\n  .Button {\n    padding: 10px 20px;\n  }\n}\n<\/style>","color_scheme":"scheme-1","padding_top":20,"padding_bottom":20}}},"order":["contact_form_kyG9gy","custom_liquid_ryyfwx","custom_liquid_9qqD6r","custom_liquid_Qfk6zQ","custom_liquid_BCmnr7","custom_liquid_9GYzCt"]}